# Music Enrichment API Keys Configuration
# Copy this file to .env and add your API keys

# Last.fm API Key (free)
# Get it from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# OpenAI API Key (optional, for AI-powered descriptions)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Grok API key (for descriptions)
GROQ_API_KEY=your_grok_api_key_here

# Spotify API Keys (already configured in .spotify_credentials)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=https://127.0.0.1:8888/callback
